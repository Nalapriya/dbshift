      {
        "identifier": "d4b518c0-5c6d-3f8e-a9b1-2c7d9e4f5a03",
        "instanceIdentifier": "d4b518c0-5c6d-3f8e-a9b1-2c7d9e4f5a03",
        "name": "Prepare SQL 001 — generate-player-360-report",
        "comments": "",
        "position": {
          "x": -400.0,
          "y": 0.0
        },
        "type": "org.apache.nifi.processors.attributes.UpdateAttribute",
        "bundle": {
          "group": "org.apache.nifi",
          "artifact": "nifi-update-attribute-nar",
          "version": "2025.8.22.17"
        },
        "properties": {
          "Delete Attributes Expression": null,
          "Store State": "Do not store state",
          "sql.q.001.generate-player-360-report": "WITH CalculatedFields AS ( SELECT PlayerId, FirstName, Location, Risk_Category, Age, (IFNULL(Total_No_Games, 0) * 0.3 + IFNULL(Time_Spent, 0) * 0.4 + IFNULL(Value_Of_Promotions_Used, 0) * 0.2 - IFNULL(Visit_Frequency_Days, 0) * 0.1) AS EngagementScore, REGEXP_LIKE(FirstName, '[0-9]') AS NameHasDigits, CASE WHEN ? IS NOT NULL AND POSITION(LOWER(?), LOWER(IFNULL(Location, ''))) > 0 THEN TRUE ELSE FALSE END AS LocContainsKeyword, TRY_CAST(Age AS INT) AS AgeInt, Visit_Frequency_Days FROM dbo.Player_360_Summary WHERE AmntBet >= ? AND (? IS NULL OR Risk_Category = ?) AND (? IS NULL OR POSITION(LOWER(?), LOWER(Location)) > 0) ), TieredPlayers AS ( SELECT PlayerId, EngagementScore, Risk_Category, NameHasDigits, LocContainsKeyword, AgeInt, CASE WHEN EngagementScore >= 80 AND IFNULL(Visit_Frequency_Days, 999) <= 5 AND NameHasDigits = FALSE AND (AgeInt BETWEEN 25 AND 45) THEN 'Gold' WHEN EngagementScore >= 50 AND IFNULL(Visit_Frequency_Days, 999) <= 10 AND LocContainsKeyword = TRUE THEN 'Silver' WHEN EngagementScore >= 30 AND IFNULL(AgeInt, 0) < 25 THEN 'Bronze' ELSE 'Newbie' END AS PlayerTier FROM CalculatedFields ) SELECT PlayerId, PlayerTier, EngagementScore, Risk_Category, NameHasDigits, LocContainsKeyword, AgeInt, RANK() OVER (ORDER BY EngagementScore DESC, PlayerId) AS PlayerRank FROM TieredPlayers ORDER BY PlayerRank, PlayerTier DESC, EngagementScore DESC;"
        },
        "propertyDescriptors": {
