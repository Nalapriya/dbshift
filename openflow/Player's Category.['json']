          "Support Fragmented Transactions": "true",
          "putsql-sql-statement": "-- This Snowflake script converts the T-SQL stored procedure usp_Player360_WithLoop.\n-- Key Optimizations:\n-- 1. Procedural Loop to Set-Based: The inefficient T-SQL WHILE loop that processes one row at a time has been completely\n--    eliminated and replaced with a single, set-based SELECT statement using Common Table Expressions (CTEs).\n--    This is the most critical optimization for performance in a columnar, MPP database like Snowflake.\n-- 2. Temporary Tables Removed: The two T-SQL temporary tables (#PlayerTemp, #Results) are no longer needed.\n--    The CTEs logically replace them in-flight within a single query.\n-- 3. Function Translation: T-SQL specific functions have been mapped to their Snowflake equivalents:\n--    - ISNULL() -> COALESCE() (ANSI standard)\n--    - PATINDEX() -> REGEXP_LIKE() (for more powerful and direct pattern matching)\n--    - CHARINDEX() -> CONTAINS() (for readable substring checks)\n--    - TRY_CONVERT() -> TRY_CAST()\n-- 4. Data Type Mapping: T-SQL data types like NVARCHAR and DECIMAL are mapped to Snowflake's VARCHAR and NUMBER.\n--    The BIT type is conceptually mapped to BOOLEAN for clearer logic (e.g., 'NOT NameHasDigits' instead of 'NameHasDigits = 0').\n-- 5. Modern Procedure Syntax: The script uses the modern Snowflake `CREATE OR REPLACE PROCEDURE ... RETURNS TABLE(...)` syntax,\n--    which allows the procedure to be called like a table function (e.g., `CALL usp_Player360_SetBased(...)` or `SELECT * FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))`).\n\nCREATE OR REPLACE PROCEDURE usp_Player360_SetBased(\n    MINAMNTBET_ARG NUMBER(18,2) DEFAULT 500,\n    RISKLEVEL_ARG VARCHAR DEFAULT NULL,\n    LOCATIONKEYWORD_ARG VARCHAR DEFAULT NULL\n)\nRETURNS TABLE (\n    PlayerId INT,\n    PlayerTier VARCHAR(20),\n    EngagementScore FLOAT,\n    Risk_Category VARCHAR(50),\n    NameHasDigits BOOLEAN,\n    LocContainsKeyword BOOLEAN,\n    AgeInt INT,\n    PlayerRank BIGINT\n)\nLANGUAGE SQL\nAS\n$$\nWITH FilteredPlayers AS (\n    -- Step 1: Filter players based on input parameters. This replaces the first temp table (#PlayerTemp).\n    SELECT\n        PlayerId,\n        FirstName,\n        Location,\n        AmntBet,\n        Total_No_Games,\n        Time_Spent,\n        Value_Of_Promotions_Used,\n        Visit_Frequency_Days,\n        Risk_Category,\n        Age\n    FROM Player_360_Summary -- Assumes the database and schema context (e.g., GAMING_WAREHOUSE.DBO) is set.\n    WHERE\n        AmntBet >= MINAMNTBET_ARG\n        AND (RISKLEVEL_ARG IS NULL OR Risk_Category = RISKLEVEL_ARG)\n        -- T-SQL's CHARINDEX check is replaced with the more idiomatic CONTAINS function.\n        AND (LOCATIONKEYWORD_ARG IS NULL OR CONTAINS(LOWER(Location), LOWER(LOCATIONKEYWORD_ARG)))\n),\n\nCalculatedMetrics AS (\n    -- Step 2: Calculate intermediate metrics for all filtered players at once.\n    -- This replaces the main logic inside the T-SQL WHILE loop.\n    SELECT\n        *, -- Select all columns from FilteredPlayers\n        -- Engagement Score Calculation\n        -- T-SQL's ISNULL is replaced with the ANSI standard COALESCE.\n        (COALESCE(Total_No_Games, 0) * 0.3\n         + COALESCE(Time_Spent, 0) * 0.4\n         + COALESCE(Value_Of_Promotions_Used, 0) * 0.2\n         - COALESCE(Visit_Frequency_Days, 0) * 0.1) AS EngagementScore,\n\n        -- NameHasDigits Calculation\n        -- T-SQL's PATINDEX('%[0-9]%') is replaced with Snowflake's REGEXP_LIKE for a direct boolean result.\n        REGEXP_LIKE(FirstName, '.*[0-9].*') AS NameHasDigits,\n\n        -- LocContainsKeyword Calculation\n        -- T-SQL's CHARINDEX is replaced with CONTAINS for clarity.\n        (LOCATIONKEYWORD_ARG IS NOT NULL AND CONTAINS(LOWER(COALESCE(Location,'')), LOWER(LOCATIONKEYWORD_ARG))) AS LocContainsKeyword,\n\n        -- AgeInt Calculation\n        -- T-SQL's TRY_CONVERT is replaced with Snowflake's TRY_CAST.\n        TRY_CAST(Age AS INT) AS AgeInt\n    FROM FilteredPlayers\n),\n\nTieredPlayers AS (\n    -- Step 3: Determine the Player Tier using a CASE statement, referencing the calculated metrics.\n    SELECT\n        PlayerId,\n        Risk_Category,\n        EngagementScore,\n        NameHasDigits,\n        LocContainsKeyword,\n        AgeInt,\n        CASE\n            -- Note: NameHasDigits is a BOOLEAN, so we use 'NOT NameHasDigits' instead of 'NameHasDigits = 0'.\n            WHEN EngagementScore >= 80 AND COALESCE(Visit_Frequency_Days, 999) <= 5 AND NOT NameHasDigits AND AgeInt BETWEEN 25 AND 45 THEN 'Gold'\n            -- Note: LocContainsKeyword is a BOOLEAN, so we check it directly instead of 'LocContainsKeyword = 1'.\n            WHEN EngagementScore >= 50 AND COALESCE(Visit_Frequency_Days, 999) <= 10 AND LocContainsKeyword THEN 'Silver'\n            WHEN EngagementScore >= 30 AND COALESCE(AgeInt, 0) < 25 THEN 'Bronze'\n            ELSE 'Newbie'\n        END AS PlayerTier\n    FROM CalculatedMetrics\n)\n\n-- Final SELECT: Combine results, add ranking, and order the output.\n-- This replaces the final SELECT from the #Results temp table.\nSELECT\n    PlayerId,\n    PlayerTier,\n    EngagementScore,\n    Risk_Category,\n    NameHasDigits,\n    LocContainsKeyword,\n    AgeInt,\n    RANK() OVER (ORDER BY EngagementScore DESC, PlayerId ASC) AS PlayerRank\nFROM TieredPlayers\nORDER BY PlayerRank ASC, PlayerTier DESC, EngagementScore DESC\n$$;\n--End_DBShift",
